# Copie para .env e preencha. O .env NAO vai para o git (esta no .gitignore).
#
# Com este arquivo, ./build.sh embute os valores no .cia/.3dsx e o 3DS
# nao pede nada na tela de config. Sem ele, o app abre pedindo os dados.
#
# ATENCAO: a chave fica dentro do binario gerado. Nao distribua esse .cia.

IMMICH_SERVER=http://192.168.0.10:2283
IMMICH_API_KEY=cole_aqui_sua_api_key
IMMICH_TZ=-03:00
